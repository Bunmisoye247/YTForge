# Copy to .env and fill in real values. Never commit the real .env file.

# App
YTFORGE_APP_ENV=development

# Database (referenced by config/*.yaml via ${DATABASE_PASSWORD})
DATABASE_PASSWORD=changeme

# JWT signing secret (referenced by config/*.yaml via ${JWT_SECRET})
JWT_SECRET=changeme

# Envelope-encryption master key (KEK) for channel OAuth refresh tokens —
# base64-encoded 32 random bytes, e.g. `openssl rand -base64 32`.
ENCRYPTION_MASTER_KEY=changeme

# Google OAuth app credentials (YouTube channel linking) — from a Google
# Cloud Console project with the YouTube Data API v3 + YouTube Analytics
# API enabled. Leave unset to keep channel linking non-functional locally.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# AI provider API keys (referenced by config/*.yaml — leave unset to skip
# registering that provider with the ModelRouter; local/self-hosted
# providers like Ollama/LM Studio/ComfyUI/A1111/Kokoro/Piper use base_url
# instead and need no key).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
FLUX_API_KEY=
VEO_API_KEY=
RUNWAY_API_KEY=
KLING_API_KEY=
LUMA_API_KEY=
HAILUO_API_KEY=
ELEVENLABS_API_KEY=
PLAYHT_API_KEY=
AZURE_TTS_API_KEY=
SUNO_API_KEY=
UDIO_API_KEY=
MUBERT_API_KEY=

# Set to "fake" to run every agent against infrastructure/providers/
# fakeprovider/ instead of real providers — no keys or local model servers
# needed. See YTFORGE__MODELS__PROVIDER_SET.
# YTFORGE__MODELS__PROVIDER_SET=fake

# Direct overrides follow the YTFORGE__SECTION__KEY convention, e.g.:
# YTFORGE__DATABASE__HOST=localhost
# YTFORGE__DATABASE__PORT=5432
# YTFORGE__TEMPORAL__HOST=localhost:7233
# YTFORGE__REDIS__URL=redis://localhost:6379/0
# YTFORGE__MINIO__ENDPOINT=localhost:9000
# YTFORGE__MINIO__ACCESS_KEY=minioadmin
# YTFORGE__MINIO__SECRET_KEY=minioadmin

# --- Docker Compose only (deploy/compose/docker-compose.yml) ---
# MinIO container's own root credentials (compose sets these as
# MINIO_ROOT_USER/MINIO_ROOT_PASSWORD directly; the app-side
# YTFORGE__MINIO__ACCESS_KEY/SECRET_KEY above must match).
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Baked into the frontend image at build time (Next.js inlines
# NEXT_PUBLIC_* vars into the client bundle — this can't be a plain
# runtime override like the YTFORGE__ vars above).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Only needed if you're actually running the Google OAuth flow against
# the Docker Compose stack instead of a local `uv run ytforge serve`.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Set only when you've also started the `observability` compose profile
# (Phase 9/10) — enables real OTel trace/metric/log export from
# api/worker/renderer. Empty (default) disables instrumentation entirely.
# OTEL_EXPORTER_ENDPOINT=otel-collector:4317
