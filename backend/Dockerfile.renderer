# syntax=docker/dockerfile:1
# The `renderer` deployable unit (ARCHITECTURE.md §1/§13) — same app code
# and builder stage as the main Dockerfile, but the runtime stage adds
# ffmpeg + fonts + media libs so `FFmpegEditingPipeline` (Phase 7) can
# actually shell out to `ffmpeg`. Kept out of the lean `Dockerfile` used
# by api/worker/relay so those images stay small and don't carry media
# tooling they never use.

FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /uvx /bin/

WORKDIR /app/backend
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

COPY backend/pyproject.toml backend/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev

COPY backend/ ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

FROM python:3.12-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system ytforge && useradd --system --gid ytforge --create-home --home-dir /app ytforge

WORKDIR /app
COPY --from=builder --chown=ytforge:ytforge /app/backend /app/backend
COPY --chown=ytforge:ytforge config /app/config

ENV PATH="/app/backend/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    YTFORGE_APP_ENV=production

WORKDIR /app/backend
USER ytforge

ENTRYPOINT ["ytforge"]
CMD ["run-renderer"]
